{
  "name": "grillo",
  "productName": "Grillo",
  "version": "0.1.0",
  "private": true,
  "description": "Grillo desktop app",
  "main": "./out/main/index.js",
  "engines": {
    "node": "24.4.1"
  },
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --publish never",
    "rebuild:native": "electron-builder install-app-deps",
    "postinstall": "node scripts/node-pty-permissions.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
